# Cloud provider selection: "localstack" or "aws"
CLOUD_PROVIDER=localstack

# AWS region used for all clients
AWS_REGION=us-east-1

# Credentials — LocalStack ignores these but boto3 requires *something* to be set.
# For CLOUD_PROVIDER=aws, unset these and rely on the default credential chain
# (environment, shared config, instance role, etc.) instead of hardcoding real keys here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack endpoint. When running the API via `docker compose up`, this is overridden
# to http://localstack:4566 (the in-network service name). When running the API directly
# on the host (e.g. `uvicorn` from your shell), use http://localhost:4566.
AWS_ENDPOINT_URL=http://localhost:4566

# Uvicorn bind port
API_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
